# syntax=docker/dockerfile:1.4
FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# Tout copier d'un coup : contourne un bug d'ordre de BuildKit sous Windows.
FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @calc3d/common run build
RUN pnpm --filter @calc3d/frontend run build

# Production : nginx non privilégié (pas de root dans le conteneur)
FROM nginxinc/nginx-unprivileged:stable-alpine AS production

COPY --from=build /app/packages/frontend/dist /usr/share/nginx/html

# Config nginx : routage SPA + proxy API (écrite en root, servie par nginx)
USER root
RUN printf 'server {\n\
    listen 8080;\n\
    server_name _;\n\
    absolute_redirect off;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    # Import des donnees bureau (lot 3) : CSV de quelques Mo.\n\
    client_max_body_size 20m;\n\
\n\
    location /api {\n\
        proxy_pass http://backend:3001;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
        proxy_read_timeout 120s;\n\
        proxy_send_timeout 120s;\n\
    }\n\
\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    gzip on;\n\
    gzip_types text/plain text/css application/json application/javascript text/xml;\n\
}\n' > /etc/nginx/conf.d/default.conf
USER nginx

EXPOSE 8080
